# Development files
.vscode/**
.vscode-test/**
src/**
scripts/**
node_modules/**

# Config files
.gitignore
.eslintrc.json
tsconfig.json
*.md
!README.md
!CHANGELOG.md

# Generated / sample PDFs, example sources, and README screenshots
# (vsce points the README's relative image links at GitHub, so they need not ship)
*.pdf
examples/**
images/**

# Build artifacts. vsce treats "!" patterns as always-include, so none may cover
# all of out/: only the esbuild bundle ships; tsc's per-file outputs are for tests.
**/*.map
**/*.ts
out/*.js
!out/extension.js

# Test files
test/**
**/test/**
**/*.test.js

# Sample files
sample.*
tiered-update-architecture.*

# Package files
*.vsix
